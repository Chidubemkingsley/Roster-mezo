# Roster Finance — Mezo testnet configuration
# Copy to .env and source with exported variables:
#   set -a; . ./.env; set +a
# NEVER commit .env or a real private key.

MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
MEZO_TESTNET_CHAIN_ID=31611

# Deployer key. Keep it outside the repository.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Read only by script/DeploySeries.s.sol, where the writer must be the
# deploying EOA. DeployStack.s.sol ignores this value: its series writer is
# the newly deployed RosterTroveWriter vault.
WRITER_ADDRESS=0xYOUR_WRITER_ADDRESS

# Verified Mezo testnet assets (checked on-chain against chain ID 31611).
MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
BTC_ADDRESS=0x7b7C000000000000000000000000000000000000

# Verified Mezo MUSD protocol contracts (chain ID 31611).
BORROWER_OPERATIONS_ADDRESS=0xCdF7028ceAB81fA0C6971208e83fa7872994beE5
TROVE_MANAGER_ADDRESS=0xE47c80e8c23f6B4A1aE41c34837a0599D5D16bb0
MEZO_PRICE_FEED_ADDRESS=0x86bCF0841622a5dAC14A313a15f96A95421b9366

# Series terms. K_RAW is MUSD per BTC with 18 decimals. It must be divisible by 1e6.
STRIKE_RAW=80000000000000000000000
PREMIUM_PER_LOT_RAW=1000000000000000
# Example value from the live main series: 2026-11-24 11:17:06 UTC.
# Replace with a future timestamp before a new deployment.
EXPIRY=1795519026
SERIES_NAME="Roster Mezo BTC Put (Trove)"
SERIES_SYMBOL=rBTC-PUT-T

# Trove-backed writer configuration.
# TROVE_COLLATERAL_RAW is NATIVE BTC posted to Mezo, not the ERC-20 BTC at
# BTC_ADDRESS. TROVE_DEBT_RAW is the requested borrow, not final debt.
# Final trove debt also includes the borrowing fee and 200 MUSD gas
# compensation; at deployment, 2,000 requested became 2,202 MUSD of debt.
TROVE_COLLATERAL_RAW=43000000000000000
TROVE_DEBT_RAW=2000000000000000000000
SERIES_DEPOSIT_RAW=1500000000000000000000
MIN_ICR_RAW=1500000000000000000
